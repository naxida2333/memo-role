<?xml version="1.0" encoding="utf-8"?>
<!--
  memo-role 安卓客户端：原生界面 + 内置 Linux 容器。

  APK 里带 proot 运行时、容器引导脚本与本地推理引擎（llama-server），
  首次启动时下载 Ubuntu arm64 base rootfs、装依赖、拉项目代码，
  之后服务就在这台设备上跑（见 Container.java），不需要 Termux。

  usesCleartextTraffic 必须为 true：本地服务是 http://，Android 9+ 默认禁止明文。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.memorole.app">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>